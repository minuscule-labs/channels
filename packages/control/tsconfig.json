{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "references": [
    { "path": "../core" },
    { "path": "../relay" },
    { "path": "../relay-storage-drizzle" }
  ],
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
